# =========================================================
# Copy this file to ".env" and fill in your own real values.
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows CMD)
# NEVER commit the real .env file. It is listed in .gitignore.
# =========================================================

# Port the backend listens on.
PORT=5000

# Set to "development" while coding, "production" when deployed.
# In production the API hides internal error details from clients.
NODE_ENV=development

# MongoDB connection string.
# Local example:  mongodb://127.0.0.1:27017/barber_booking
# Atlas example:  mongodb+srv://<username>:<password>@<cluster-host>/barber_booking?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/barber_booking

# Secret used to sign JWT login tokens.
# Must be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_characters

# How long a login token stays valid. Examples: 15m, 1h, 7d
JWT_EXPIRES_IN=7d

# The exact origin of your React app. Used for CORS.
# Comma-separate if you need more than one.
CLIENT_ORIGIN=http://localhost:3000
