# Raises the login/signup rate limit ONLY so the Jest integration suite
# (tests/integration.test.js) can exercise more than 10 auth calls per run
# without tripping the real production limiter (middleware/rateLimit.js).
# Leave unset in production -- see that file's comment on why this is safe.
AUTH_RATE_LIMIT_MAX=200

# Main VEYRON admin login (for /admin/login). Not read by the app itself --
# admin auth is database-backed (see server/scripts/createAdmin.js), this is
# just where the one admin account's credentials are kept for reference.
# Change ADMIN_PASSWORD here AND in the database if you rotate it -- update
# one only and they will no longer match.
ADMIN_EMAIL=admin@veyron.test
ADMIN_PASSWORD=DVbQi5KsX-QH

# Real mail delivery (see utils/mailer.js). Your Gmail app password was
# previously sitting in ADMIN_PASSWORD above and in a GMAIL_APP_PASSWORD
# variable that nothing reads -- utils/mailer.js only ever looks at these
# five names. That mismatch is why nodemailer never activated: every code
# was silently going to the dev console transport instead of Gmail.
#
# Port 587 + STARTTLS is Gmail's standard combination. SMTP_USER must be
# the full address; SMTP_PASS must be an App Password (16 characters,
# generated at https://myaccount.google.com/apppasswords -- this requires
# 2-Step Verification to be on), never your normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=azizsugh@gmail.com
SMTP_PASS="vxdh mlvt wipr lfnn"
MAIL_FROM="VEYRON <azizsugh@gmail.com>"

# Resend (https://resend.com) -- preferred over the Gmail SMTP block above
# when both are set (see utils/mailer.js for the exact precedence). Get a
# key from the Resend dashboard, uncomment RESEND_API_KEY below, and
# restart the server.
#
# ONE THING TO KNOW ABOUT A NEW RESEND ACCOUNT: until you verify a sending
# domain at https://resend.com/domains, Resend only allows delivery to the
# email address you signed up to Resend with -- every OTHER recipient gets
# silently refused. That is Resend's own anti-abuse limit, not a bug here.
# Real customers/barbers signing up with other email addresses will not
# receive their codes until a domain is verified.
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL="VEYRON <no-reply@yourdomain.com>"

# Who receives "a new barber just applied" emails (see
# utils/notificationEmails.js). Defaults to ADMIN_EMAIL above if unset.
# ADMIN_NOTIFICATION_EMAIL=admin@veyron.test

# Google Sign-In (see utils/googleAuth.js). This is a CLIENT ID, not a
# secret -- it is also embedded in the frontend's page source deliberately
# (see client/.env.local's REACT_APP_GOOGLE_CLIENT_ID), so putting it here
# too is not a new exposure. There is no client SECRET anywhere in this
# app: verifying who signed in only needs the client id, not one.
#
# To get one: https://console.cloud.google.com/apis/credentials
#   1. Create Credentials -> OAuth client ID -> Application type: Web application
#   2. Authorized JavaScript origins: http://localhost:3000 (add your real
#      domain too, once you have one)
#   3. Copy the Client ID into BOTH this line and
#      client/.env.local's REACT_APP_GOOGLE_CLIENT_ID -- they must match,
#      it is the same value read from two different processes.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com